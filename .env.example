# 管理后台密码（install.sh 会自动生成随机密码，此项必改）
ADMIN_PASSWORD=change-this-password

# 宿主机映射端口（8080 被占用时 install.sh 会自动换一个）
HOST_PORT=8080

# 站点信息
SITE_TITLE=站点服务状态
SITE_DESCRIPTION=实时监控站点与各项服务的可用性
FOOTER_TEXT=

# 异常通知 Webhook：Bark / 企业微信机器人 / 飞书 / 钉钉 均可
WEBHOOK_URL=

# 自动发现：1 开启（默认），0 关闭
AUTO_DISCOVER=1
# 扫描间隔（分钟）
DISCOVER_INTERVAL_MIN=10
# 自动收录的分组名
DISCOVER_GROUP=自动发现
# 自定义端口探测列表（留空使用内置常见 Web 端口）
DISCOVER_PORTS=

# ---------- 自动更新 ----------
# 1 = 开启 watchtower，每小时检查并自动升级（默认）
# 0 = 关闭，需要时在安装目录执行 bash update.sh
AUTO_UPDATE=1
# 检查间隔（秒），3600 = 1 小时
UPDATE_INTERVAL=3600
# 使用的镜像，可换成自己的仓库或 fork 出来的 ghcr 地址
IMAGE=ghcr.io/hexoblog-web-site/beacon-monitor:latest
# 版本检测用的 GitHub 仓库（fork 了的话改这里，否则会一直提示有更新）
GITHUB_REPO=hexoblog-web-site/beacon-monitor

TZ=Asia/Shanghai
