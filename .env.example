# 复制成 .env 后按需修改：cp .env.example .env
# 只有 DB_PASS 是必填的，其余留空也能跑。

# ---------- 对外端口 ----------
# 容器里的 80 映射到宿主机这个端口；前面有 Nginx 反代时只监听本机即可，例如 127.0.0.1:8080
ZAN_PORT=8080

# ---------- 镜像 ----------
# 默认用官方镜像；填 latest / v3.0.0 之类的标签即可。拉不到会自动本地构建，留空也行
ZAN_TAG=latest

# ---------- 数据库 ----------
DB_NAME=zan
DB_USER=zan
# 必填：数据库密码。建议 openssl rand -base64 18 生成后粘进来
DB_PASS=
# 可选：root 密码，留空则与 DB_PASS 相同
DB_ROOT_PASS=
# 表前缀，多站点共用一个库时改一下
DB_PREFIX=zan_

# ---------- 站点 ----------
# 后台标题显示的名字，留空则显示 Glue
SITE_NAME=
# 博客与接口不同域时填白名单，逗号分隔，例如 https://www.example.com,https://example.com
# 同域部署（本程序挂在博客域名下）可以留空
ALLOWED_ORIGINS=

# ---------- 管理员 ----------
ADMIN_EMAIL=admin@example.com
# 留空则首次启动随机生成 16 位，密码只打印在 docker compose logs 里一次
ADMIN_PASSWORD=

# ---------- 其他 ----------
TZ=Asia/Shanghai
